# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx

# Nunca exponha esta chave ao client. Usada apenas em rotas/server code
# (ex.: src/proxy.ts, server actions, route handlers administrativos).
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx

# Domínio raiz usado para extrair o subdomínio do tenant a partir do Host.
# Em produção: dominio.com (então clinica-a.dominio.com -> subdomínio "clinica-a")
# Em dev local, use algo do tipo clinica-a.localhost:3000 (funciona sem editar hosts).
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Provisório: só defina como "query" se estiver rodando num domínio sem
# wildcard DNS (ex.: *.vercel.app antes de configurar domínio próprio).
# Nesse modo, o tenant é escolhido por ?tenant=<subdominio> (ver src/proxy.ts)
# em vez de subdomínio de verdade. Remova assim que tiver domínio próprio.
# NEXT_PUBLIC_TENANT_LINK_MODE=query
